# central identity (hostname used as host id in fleet view)
HOST_ID=central
# host port for the dashboard
PORT=8079
# demo profile port
DEMO_PORT=8081
# your node's own public IPs (excluded from attacker stats; comma-separated)
SELF_PUBLIC_IPS=
# live log path inside the container (production default)
AUTH_LOG=/var/log/auth.log
# --- auth-log privacy (no blind masking of compromises) ---
# sshd-only (default): ship/serve sshd + pam_unix(sshd) only; drops sudo
# COMMAND/PWD, CRON, systemd noise. Use "full" only for debugging.
SHIP_FILTER=sshd-only
# balanced (default): attacker IPs + ALL Accepted logins shown fully.
# strict: additionally masks usernames of *trusted* accepts + self-IP list.
# Suspicious accepts are NEVER masked.
PRIVACY_MODE=balanced
# Compromise detection: your admin IPs + legit accounts (comma-separated).
# Any Accepted login after prior fails, or from unknown IP/user when these
# are set, is flagged "suspicious" with full IP/user + red banner in UI.
# Example: TRUSTED_IPS=1.2.3.4,5.6.7.8
TRUSTED_IPS=
# Example: TRUSTED_USERS=ubuntu,deploy
TRUSTED_USERS=
# cap stored lines per host (plaintext JSONL, 0600)
MAX_LINES_PER_HOST=60000
# --- login (AUTH_MODE=local default, fail-closed) ---
# local: single user via AUTH_USER + AUTH_PASS_HASH (preferred) or AUTH_PASSWORD.
#   Mint a hash:  docker exec ssh-sentinel python3 /srv/server.py genhash
# forward/oidc: trust Authentik-via-Traefik ForwardAuth identity (X-Forwarded-User).
#   Optional allowlist: AUTH_ALLOWED_USERS=alice,bob@example.com
# none: open UI/API (private tailnet/demo only — never port-forward 8079).
AUTH_MODE=local
AUTH_USER=admin
AUTH_PASS_HASH=
AUTH_PASSWORD=
AUTH_ALLOWED_USERS=
# public abusers feed budget (requests/min per client IP)
ABUSERS_RPM=60
# optional in-repo TLS 1.3 (container paths; leave empty to terminate at Tailscale/Traefik)
TLS_CERT=
TLS_KEY=
