*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.coverage
htmlcov/
.venv/
venv/

# logs & os
*.log
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/
*.swp
*.swo
