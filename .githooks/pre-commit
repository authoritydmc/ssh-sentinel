#!/bin/sh
# Fast checks before each commit: Rust check + frontend lint.
set -e
if command -v cargo >/dev/null 2>&1 || [ -x "$HOME/.cargo/bin/cargo" ]; then
  CARGO="${CARGO:-$HOME/.cargo/bin/cargo}"
  command -v cargo >/dev/null 2>&1 && CARGO=cargo
  "$CARGO" check --manifest-path central-rs/Cargo.toml --quiet
  "$CARGO" check --manifest-path agent-rs/Cargo.toml --quiet
else
  echo "pre-commit: skip cargo check (no Rust toolchain; use WSL per skills/rust-wsl/SKILL.md)"
fi
if command -v npm >/dev/null 2>&1 && [ -d frontend/node_modules ]; then
  (cd frontend && npm run lint --silent)
else
  echo "pre-commit: skip frontend lint (no node_modules; run npm ci once)"
fi
